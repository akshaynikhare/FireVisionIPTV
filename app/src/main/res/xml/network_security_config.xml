<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        Network security configuration for FireVision IPTV.
        Enforces HTTPS-only connections for all network traffic.
        
        Requirements: TR-012 (Network Security - HTTPS only)
    -->
    
    <!-- Base configuration for all domains.
         Cleartext is permitted because bring-your-own IPTV sources (M3U/Xtream panels)
         very commonly serve over http://. The managed FireVision server is still
         reached over HTTPS with certificate pinning (enforced in OkHttp), so this does
         not weaken the managed path. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust system certificate authorities -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Debug configuration (only active in debug builds) -->
    <debug-overrides>
        <trust-anchors>
            <!-- Trust user-added certificates for debugging -->
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
